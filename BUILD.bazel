load("@rules_devicetree//devicetree:devicetree_library.bzl", "devicetree_library")

package(default_visibility = ["//vendor/nvidia:__subpackages__"])

devicetree_library(
    name = "all_t23x_dtsi",
    hdrs = glob([
        "**/*.dts",
        "**/*.dtsi",
    ]),
    includes = ["."],
    deps = [":dt-bindings"],
)


devicetree_library(
    name = "dt-bindings",
    hdrs = glob([
        "include/nvidia-oot/dt-bindings/**/*.h",
    ]),
    includes = ["include/nvidia-oot"],
)

